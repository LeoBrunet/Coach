    "NSHealthShareUsageDescription": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach reads your workouts, heart rate, sleep and HRV so your coach can adapt your plan."
